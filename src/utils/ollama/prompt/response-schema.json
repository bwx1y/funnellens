{
  "type": "object",
  "properties": {
    "lead_type": {
      "type": "string",
      "enum": ["HOT", "WARM", "COLD"]
    },
    "confidence_score": {
      "type": "number",
      "description": "Tingkat keyakinan klasifikasi dari 0.0 hingga 1.0"
    },
    "detected_product": {
      "type": ["string", "null"],
