# Frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_API_URL=

# API
NODE_ENV=development
CORS=localhost,127.0.0.1
FRONTEND_URL=http://127.0.0.1:5173
PORT=3000
SECRET=replace-with-a-long-random-secret

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=db_testing
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-me

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=noreply@localhost

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# OpenWA
OPEN_WA_URL=http://localhost:2785
OPEN_WA_APP_KEY=
OPEN_WA_WEBHOOK_URL=http://host.docker.internal:3000/api/wa/webhook
OPEN_WA_PORT=2785

# Meta Marketing API
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/meta/oauth/callback
META_API_VERSION=v21.0
META_OAUTH_SCOPES=ads_read,ads_management

# Gemini (optional; comma-separated API keys)
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# WhatsApp Cloud API and analytics
WA_VERIFY_TOKEN=
ANALYTICS_MATURITY_DAYS=7
RETENTION_INSIGHT_DAYS=400
RETENTION_MESSAGE_BODY_DAYS=180
RETENTION_SYNC_RUN_DAYS=90
